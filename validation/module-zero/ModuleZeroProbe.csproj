<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <R3CandidateVersion Condition="'$(R3CandidateVersion)' == ''">10.5.1-r3.3</R3CandidateVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Du.Abp.ZeroCore.EntityFrameworkCore" Version="[$(R3CandidateVersion)]" />
    <PackageReference Include="Castle.Windsor.MsDependencyInjection" Version="[4.1.0]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="[9.0.18]" />
  </ItemGroup>
</Project>
